# Copy this file to .env and change what you need. Everything is optional:
# without an API key the assistant still works and answers with exact quotes from your documents.

# --- Language model: any OpenAI-compatible API ---
# OpenAI: create a key at https://platform.openai.com/api-keys
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Free and local with Ollama (https://ollama.com), after running: ollama pull llama3.1
#   LLM_BASE_URL=http://localhost:11434/v1             when you run the app with Python
#   LLM_BASE_URL=http://host.docker.internal:11434/v1  when you run the app with Docker
#   LLM_MODEL=llama3.1
LLM_TIMEOUT=60
# Turn follow-up questions such as "and in the second year?" into full questions before searching
QUERY_REWRITE=true

# --- Search ---
# local = small embedding model that runs on your machine (default)
# api   = the /embeddings endpoint of the provider above (set EMBEDDING_MODEL, e.g. text-embedding-3-small)
# off   = keyword search only
EMBEDDINGS=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Passages sent to the model for each question, and how documents are cut into passages
TOP_K=6
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- App ---
COMPANY_NAME=Northwind Analytics
ASSISTANT_NAME=Knowledge Base Assistant
# Protects uploading and deleting documents. Leave it empty for a local demo.
ADMIN_TOKEN=
MAX_UPLOAD_MB=25
# Add the three demo documents on the first start
LOAD_SAMPLE_DOCS=true
# Suggested questions on the start screen, separated by |
SUGGESTED_QUESTIONS=How many vacation days do I get in my first year?|What should I do if my laptop is stolen?|Can I work from another country for a few weeks?|Which tools does Northwind connect to?
